void draw_tree(){for(int i=0;i<12;i++){AT(7+i,2);CLK;printf(G B"  %s"R,tree[st][i]);}}
const char*uc(int i){if(i==1&&(day-lw)>=WDAYS)return RD;if(i==2&&(day-lf)>=FDAYS)return Y;if(i==3&&(day-lp)>=PDAYS)return M;if(i==4&&(day-lc)>=CDAYS)return Y;return bc[i];}
void draw_bars(){
    struct{const char*l;const char*c;int v;}b[]={{"HEALTH",hp>60?G:hp>30?Y:RD,hp},{"WATER",wt>60?BL:wt>30?Y:RD,wt},{"GROWTH",M,gr}};
    for(int i=0;i<3;i++){AT(3+i,2);int f=b[i].v*35/100;printf("  %s%-8s%s[%s",W,b[i].l,R,b[i].c);for(int j=0;j<35;j++)printf(j<f?"#":"-");printf(R W"] %3d%%"R,b[i].v);}
}
void draw_hud(){AT(1,2);printf(B C"  BAMBOO LIFECYCLE  |  Stage: %-10s|  Day: %-4d  "R,sn[st],day);}
void draw_fact(){
    AT(25,57);printf(B W"+-------------------+"R);AT(26,57);printf(B Y"| FUN FACT:         |"R);AT(27,57);printf(B W"+-------------------+"R);
    char buf[80];strncpy(buf,facts[fi],79);buf[79]=0;
    int len=strlen(buf),pp=0,row=28;
    while(pp<len&&row<33){AT(row,57);int end=CL(pp+19,0,len);if(end<len){int e=end;while(e>pp&&buf[e]!=' ')e--;if(e>pp)end=e;}printf(C"%-19.*s"R,end-pp,buf+pp);pp=end;if(pp<len&&buf[pp]==' ')pp++;row++;}
    AT(33,57);printf(B W"+-------------------+"R);
}
void draw_buttons(){
    AT(1,57);printf(B W"+-------------------+"R);AT(2,57);printf(B W"|   A C T I O N S   |"R);AT(3,57);printf(B W"+-------------------+"R);
    for(int i=0;i<5;i++){
        AT(4+i*4,57);printf(B W"+-------------------+"R);
        AT(5+i*4,57);
        if(locked[i]) printf(DM W"|  %-16s |"R,"[LOCKED/DONE]");
        else if(i==sel) printf(B"\033[7m%s|  %-16s |"R,uc(i),lb[i]);
        else printf(B"%s|  %-16s |"R,uc(i),lb[i]);
        AT(6+i*4,57);printf(B W"+-------------------+"R);
    }
    AT(22,57);printf(B C"  UP/DOWN = navigate "R);AT(23,57);printf(B C"  ENTER   = select   "R);AT(24,57);printf(B C"  Q       = quit     "R);
}
void draw_warn(){
    AT(6,2);CLK;int dw=day-lw,df=day-lf,dp=day-lp,dc=day-lc;
    if(!sowed)         printf(B Y"  >> SOW SEED first to begin lifecycle!"R);
    else if(hp<=25)    printf(B RD"  !! CRITICAL: Health very low — act NOW!!"R);
    else if(wt<=15)    printf(B RD"  !! DANGER: Dehydrating — WATER NOW!!"R);
    else if(dw>=WDAYS) printf(B RD"  !! OVERDUE %d day(s): Water now!!"R,dw-WDAYS+1);
    else if(df>=FDAYS) printf(B Y"  !! OVERDUE %d day(s): Fertilize now!!"R,df-FDAYS+1);
    else if(dp>=PDAYS) printf(B M"  !! Storm risk HIGH — protect bamboo!"R);
    else if(dc>=CDAYS) printf(B Y"  !! Dead wood build-up — cut now!"R);
    else               printf(B C"  TIP: %s"R,tips[CL(st,0,6)]);
}
void do_anim(int a){
    if(sounds[a])snd(sounds[a]);
    fi=(fi+1)%NF;char*sp[]={"|","/","-","\\","|"};
    for(int f=0;f<5;f++){
        for(int rr=0;rr<7;rr++){AT(25+rr,2);CLK;printf("%s  %s"R,uc(a),frm[a][f][rr]);}
        AT(25,54);printf(B"%s%s"R,bc[a],sp[f%5]);draw_fact();fflush(stdout);S(350);
    }
    for(int rr=25;rr<34;rr++){AT(rr,2);CLK;}
}
void ns(int d){int s=sel;do{s=(s+d+5)%5;}while(locked[s]&&s!=sel);sel=s;}
void tick(){
    day++;wt=CL(wt-WDECAY,0,100);if(wt<20)hp=CL(hp-5,0,100);
    int dw=day-lw,df=day-lf,dp=day-lp,dc=day-lc;
    if(sowed){if(dw>WDAYS)hp=CL(hp-(dw-WDAYS)*3,0,100);if(df>FDAYS)gr=CL(gr-(df-FDAYS)*2,0,100);if(dp>PDAYS)hp=CL(hp-(dp-PDAYS)*2,0,100);if(dc>CDAYS)hp=CL(hp-(dc-CDAYS)*2,0,100);}
    if(st<6&&gr>=gn[st+1]){st++;snd(sUP);}
}

int main(){
    srand((unsigned)time(NULL));
    splash();
    CLS;printf("\033[?25l");
    t0=time(NULL);ltick=t0;
    draw_hud();draw_bars();draw_tree();draw_buttons();draw_fact();draw_warn();
    fflush(stdout);
    int ch,over=0;
    while(!over){
#ifdef _WIN32
        if(_kbhit()){
            ch=_getch();
#else
        ch=getchar();if(ch!=EOF){
#endif
            if(ch==224||ch==0){
#ifdef _WIN32
                ch=_getch();
#else
                ch=getchar();
#endif
                if(ch==72)ns(-1);if(ch==80)ns(1);
            } else if(ch==13||ch=='\n'){
                if(locked[sel]){AT(6,2);CLK;printf(B RD"  !! Locked — complete previous steps!"R);fflush(stdout);S(700);}
                else{
                    if(sel==0){sowed=1;locked[0]=1;locked[1]=locked[2]=locked[3]=locked[4]=0;lw=lf=lp=lc=day;sel=1;gr=CL(gr+10,0,100);}
                    else if(sel==1){wt=100;hp=CL(hp+5,0,100);gr=CL(gr+3,0,100);lw=day;}
                    else if(sel==2){gr=CL(gr+18,0,100);hp=CL(hp+5,0,100);lf=day;}
                    else if(sel==3){hp=CL(hp+22,0,100);gr=CL(gr+2,0,100);lp=day;}
                    else if(sel==4){hp=CL(hp+8,0,100);wt=CL(wt+5,0,100);gr=CL(gr+6,0,100);lc=day;}
                    int rr=rand()%10;
                    if(rr==0){wt=CL(wt-20,0,100);AT(6,2);CLK;printf(RD B"  !! DROUGHT! Moisture -20"R);}
                    else if(rr==1){hp=CL(hp-12,0,100);AT(6,2);CLK;printf(RD B"  !! PEST ATTACK! Health -12"R);}
                    else if(rr==2){gr=CL(gr+7,0,100);AT(6,2);CLK;printf(G B"  !! PERFECT WEATHER! Growth +7"R);}
                    else if(rr==3){hp=CL(hp+8,0,100);AT(6,2);CLK;printf(G B"  !! HEALING RAIN! Health +8"R);}
                    do_anim(sel);draw_tree();
                }
            } else if(ch=='q'||ch=='Q') break;
        }
        time_t now=time(NULL);
        if((now-ltick)>=DAY_SEC){ltick=now;if(sowed)tick();}
        draw_hud();draw_bars();draw_buttons();draw_warn();draw_fact();
        if(hp<=0){AT(6,2);CLK;printf(B RD"  !! GAME OVER — Bamboo died! Press Q."R);snd(sDIE);over=1;}
        else if(st==6&&gr>=100){AT(6,2);CLK;printf(B G"  !! YOU WIN! ANCIENT BAMBOO! Press Q."R);snd(sWIN);over=1;}
        fflush(stdout);S(180);
    }
#ifdef _WIN32
    while(_kbhit())_getch();_getch();
#endif
    printf("\033[?25h");CLS;
    printf(B W"\n  Game Over!  Stage: %s | Days: %d\n\n"R,sn[st],day);
    return 0;
}
